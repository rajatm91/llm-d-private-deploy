# Single source of truth for every script. Edit, then `source` is done by scripts/lib.sh.
# Override path with: CONFIG=/path/to/other.env ./scripts/<step>.sh

# ---------- GCP ----------
PROJECT_ID=my-project
REGION=us-central1
CLUSTER_NAME=my-gke-cluster          # used by preflight (Workload Identity check); empty = skip
CLUSTER_LOCATION=us-central1         # region or zone of the cluster

# ---------- Artifact Registry ----------
AR_HOST=${REGION}-docker.pkg.dev
AR=${AR_HOST}/${PROJECT_ID}/llm-d   # your mirror repo

# copy   = standard AR repo; 10-bundle.sh pushes images into it with crane.
# remote = AR *remote* repo (pull-through proxy); nothing is pushed, 10-bundle.sh only warms the cache.
MIRROR_MODE=copy

# Upstream images pinned by llm-d v0.9.0 (release-0.9). Do not change unless you know why.
VLLM_UPSTREAM=docker.io/vllm/vllm-openai:v0.26.0
EPP_UPSTREAM=ghcr.io/llm-d/llm-d-router-endpoint-picker:v0.10.0
ENVOY_UPSTREAM=docker.io/envoyproxy/envoy:distroless-v1.33.2
CURL_UPSTREAM=docker.io/cfmanteiga/alpine-bash-curl-jq:latest

# Image refs as the CLUSTER pulls them. Default = upstream path under ${AR}.
# Remote repos: set these to match your remote repo layout (ghcr.io needs its own custom-upstream remote repo).
VLLM_IMAGE=${AR}/${VLLM_UPSTREAM#*/}
EPP_IMAGE=${AR}/${EPP_UPSTREAM#*/}
ENVOY_IMAGE=${AR}/${ENVOY_UPSTREAM#*/}
CURL_IMAGE=${AR}/${CURL_UPSTREAM#*/}

# ---------- llm-d versions (v0.9.0) ----------
LLMD_REF=v0.9.0
ROUTER_CHART=llm-d-router-standalone
ROUTER_CHART_VERSION=v0.10.0
GAIE_VERSION=v1.5.0

# Optional: also push the router chart to a *standard* AR repo and install from there.
# Empty = install from the bundled .tgz (recommended, nothing to log in to).
CHART_OCI_REPO=                      # e.g. oci://${AR}/charts

# ---------- Deployment ----------
NAMESPACE=llm-d-optimized-baseline
RELEASE=optimized-baseline           # helm release; EPP service = ${RELEASE}-epp
MODEL_ID=Qwen/Qwen3-32B              # served model name == path under the bucket
MODEL_BUCKET=my-model-bucket         # gs://${MODEL_BUCKET}/${MODEL_ID}/config.json must exist
REPLICAS=8
TP=2                                 # tensor parallel size == GPUs per replica
GCSFUSE_FILE_CACHE=100Gi             # node ephemeral storage used by gcsfuse file cache

# ---------- Bundle transfer ----------
BUNDLE_GCS=gs://my-transfer-bucket/llm-d   # where 10-bundle.sh uploads; empty = skip upload
